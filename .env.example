# Copy to .env.local for local development (or run `vercel env pull .env.local`).
# Never commit real values.

# Firebase Admin service account (Firebase Console → Project settings → Service accounts)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Xendit platform (master) account secret key — creates seller sub-accounts (XenPlatform)
# and plan-subscription invoices. Needs Money-in write + XenPlatform permissions.
XENDIT_SECRET_KEY=

# Encrypts vault passwords/PINs at rest (AES-256-GCM). REQUIRED in production; never
# change or lose it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Xendit → Settings → Webhooks → "Webhook verification token".
# Callback URL to configure there: https://<dashboard-domain>/api/webhooks/xendit
XENDIT_WEBHOOK_TOKEN=

# n8n automation (Pro/Ultimate WhatsApp delivery, H-3 reminders, broadcast) — docs/n8n.md
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Protects /api/cron/renewal-reminders (Vercel Cron sends it automatically).
CRON_SECRET=

# Optional: attach Ultimate custom domains to the storefront Vercel project automatically.
VERCEL_TOKEN=
VERCEL_STOREFRONT_PROJECT_ID=
VERCEL_TEAM_ID=

# Public origin of this dashboard, used for Telegram/Discord webhook URLs (defaults to the request host).
DASHBOARD_PUBLIC_URL=

# Comma-separated emails that can open /platform (must be verified Firebase accounts).
PLATFORM_ADMIN_EMAILS=

# Storefront addressing. With a root domain, stores live at <slug>.<root>.
# Without one, links fall back to <NEXT_PUBLIC_STOREFRONT_URL>/<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Local testing against the Firebase emulators instead of the real project:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
