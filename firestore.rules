rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles: Users can read/write their own profile
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stores: Users can only read/write stores they own
    match /stores/{storeId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.owner_id;
      // Allow creation if the owner_id matches their uid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner_id;
    }

    // Inventory: Users can only read/write inventory for stores they own
    match /inventory/{itemId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.owner_id;
      // Allow creation if the linked store belongs to them
      allow create: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.owner_id;
    }

    // Customers: Users can only read/write customers for stores they own
    match /customers/{customerId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.owner_id;
      allow create: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.owner_id;
    }

    // Subscriptions: Users can only read/write subscriptions for stores they own
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.owner_id;
    }
  }
}
